[Unit]
Description=tutor_pi 更新元数据同步（从上游 GitHub release 拉取 latest.yml / latest.json）
Documentation=file:///srv/tpi-update/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# 由 install.sh 替换成实际部署用户
User=__RUN_USER__
Group=__RUN_USER__

ExecStart=/usr/bin/python3 /usr/local/bin/tpi-update-sync.py

# ---- 配置 ----
Environment=TPI_SYNC_DEST=/srv/tpi-update/update
Environment=TPI_SYNC_HISTORY_KEEP=5
Environment=TPI_SYNC_ASSET_TIMEOUT=20
# 第二个上游示例（GitHub 或 R2 或 Gist 都行，按序回退）：
# Environment=TPI_SYNC_SOURCES=https://github.com/wanshushan/tpi-release/releases/latest/download,https://dl2.wanshushan.top/meta

# ---- 加固：除 /srv/tpi-update 之外整个文件系统只读 ----
ProtectSystem=strict
ReadWritePaths=/srv/tpi-update
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
NoNewPrivileges=true

# 单次最多跑 3 分钟。上游 GitHub 很慢/不通时单次会卡满上限（实测约 5 次里通 1 次）。
# 脚本内的网络请求和资产预检都带超时，失败只是【保持现有文件】，不影响线上。
#
# 注意【调度器不是 systemd】：1Panel 计划任务跑 /usr/local/bin/tpi-release-sync.sh，
# 那个脚本再 systemctl start 本单元，只借这里的只读沙箱。调度权 100% 在 1Panel。
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
